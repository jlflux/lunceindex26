# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Server-only. Never expose to the browser. Used by admin write routes + seeding.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Admin login. Generate the hash with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Random 32+ char string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
